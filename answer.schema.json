{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSO429 round answer",
  "type": "object",
  "required": ["round_id", "answers"],
  "additionalProperties": false,
  "properties": {
    "round_id": {"type": "integer", "minimum": 1, "maximum": 168},
    "answers": {
      "type": "object",
      "minProperties": 25,
      "maxProperties": 25,
      "patternProperties": {"^q([1-9]|1[0-9]|2[0-5])$": {"enum": ["A", "B", "C", "D"]}},
      "additionalProperties": false
    }
  }
}
